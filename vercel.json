{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "admin": {
      "root": "admin",
      "routes": [
        {
          "src": "/admin",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        },
        {
          "src": "/admin/add",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        },
        {
          "src": "/admin/list",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        },
        {
          "src": "/admin/orders",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        },
        {
          "src": "/admin/assets/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/assets/$1"
            }
          ]
        },
        {
          "src": "/admin/vite.svg",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/vite.svg"
            }
          ]
        },
        {
          "src": "/admin/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/index.html"
            }
          ]
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/images/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
